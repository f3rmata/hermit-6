CompileFlags:
  CompilationDatabase: linux-stable
  Remove:
    - -mpreferred-stack-boundary=3
    - -mindirect-branch=thunk-extern
    - -mindirect-branch-register
    - -fno-allow-store-data-races
    - -fmin-function-alignment=16
    - -fconserve-stack
  Add:
    - -Wno-unknown-warning-option
    - -Wno-unused-command-line-argument
    # scripts/Makefile.extrawarn disables this for clang builds; without it the
    # LSP reports upstream enum-arithmetic (e.g. mm/vmscan.c) as blocking.
    - -Wno-enum-enum-conversion
    - -Wno-enum-conversion

Diagnostics:
  Suppress:
    - drv_unknown_argument
